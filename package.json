{
  "name": "poster35-store",
  "version": "1.0.0",
  "description": "Premium Poster Ordering Website - Fixed ₹35 per poster",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build && npm --prefix backend install",
    "start": "node --experimental-strip-types backend/src/server.ts",
    "clear:orders": "node --experimental-strip-types scripts/clear-orders.js",
    "db": "node --experimental-strip-types scripts/db-tool.js",
    "db:aiven": "node scripts/deploy-aiven-mysql.js",
    "seed": "node --experimental-strip-types backend/src/seed.ts",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "node scripts/start-dev.js",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}
